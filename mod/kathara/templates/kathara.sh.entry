#!/bin/sh
# Generated by dot2net. The entry point for this lab on Kathara: run it from
# anywhere, it works out where its files are.
#
# Kathara reads lab.conf and <device>.startup from the directory it runs in, so
# this script changes into it first. exec goes through docker: kathara exec
# cannot pass a command containing -c (see doc/active/TESTBED_NOTES.md).
set -e
cd "$(dirname "$0")"

case "${1:-deploy}" in
  deploy)
    exec sudo kathara lstart --noterminals
    ;;
  destroy)
    exec sudo kathara lclean
    ;;
  exec)
    shift
    [ $# -ge 2 ] || { echo "usage: $0 exec <node> <command>..." >&2; exit 2; }
    node="$1"; shift
    exec sudo docker exec "$(sudo docker ps --filter name="$node" -q | head -1)" "$@"
    ;;
  *)
    echo "usage: $0 {deploy|destroy|exec <node> <command>...}" >&2
    exit 2
    ;;
esac

#!/bin/sh
# Generated by dot2net. The entry point for this lab on containerlab: run it
# from anywhere, it works out where its files are.
#
# destroy does more than containerlab's own: it runs the lab's teardown
# commands, copies out what the lab was asked to bring back, and only then
# takes the lab down. A step that fails is named and the rest still runs - a
# lab left standing because something could not be copied is worse than the
# missing file - and the script ends non-zero so that whatever called it knows.
cd "$(dirname "$0")"
TOPO="%%TOPO%%"
COLLECT_DIR="${DOT2NET_COLLECT_DIR:-%%COLLECT%%}"
LAB="${DOT2NET_LAB_NAME:-}"

failed=""
note_failure() {
  failed="$failed
  $1"
  echo "dot2net: FAILED $1" >&2
}
report() {
  [ -n "$failed" ] || return 0
  echo "dot2net: these steps failed:$failed" >&2
  exit 1
}

# containerlab names a container after the lab and the node. The lab name comes
# from the topology file unless one was given, which is what lets the same lab
# be deployed more than once at a time.
container_id() {
  if [ -n "$LAB" ]; then
    sudo docker ps -q --filter "label=clab-node-name=$1" --filter "name=clab-$LAB-$1" | head -1
  else
    sudo docker ps -q --filter "label=clab-node-name=$1" | head -1
  fi
}

# Commands the lab wants run inside a node while it is still up. The block is
# fed to a shell on stdin so that it can be more than one line.
teardown_node() {
  node="$1"
  cid=$(container_id "$node")
  if [ -z "$cid" ]; then
    note_failure "teardown $node: no container"
    cat >/dev/null
    return
  fi
  sudo docker exec -i "$cid" sh -s || note_failure "teardown $node"
}

collect_file() {
  node="$1"
  path="$2"
  cid=$(container_id "$node")
  if [ -z "$cid" ]; then
    note_failure "collect $node:$path: no container"
    return
  fi
  dest="$COLLECT_DIR/$node$path"
  mkdir -p "$(dirname "$dest")"
  sudo docker cp "$cid:$path" "$dest" || note_failure "collect $node:$path"
}

run_teardown() {
  :
{{ .nodes_clab_teardown }}
}

run_collect() {
  :
{{ .nodes_clab_collect }}
}

deploy_args() {
  [ -n "$LAB" ] && printf ' --name %s' "$LAB"
}

case "${1:-deploy}" in
  deploy)
    # shellcheck disable=SC2046
    exec sudo containerlab deploy -t "$TOPO" $(deploy_args)
    ;;
  destroy)
    run_teardown
    run_collect
    # shellcheck disable=SC2046
    sudo containerlab destroy -t "$TOPO" --cleanup $(deploy_args) || note_failure "destroy"
{{ .nodes_clab_bridge_cleanup }}
    report
    ;;
  collect)
    [ -n "$2" ] && COLLECT_DIR="$2"
    run_collect
    report
    ;;
  exec)
    shift
    [ $# -ge 2 ] || { echo "usage: $0 exec <node> <command>..." >&2; exit 2; }
    node="$1"; shift
    exec sudo containerlab exec -t "$TOPO" --label clab-node-name="$node" --cmd "$*"
    ;;
  *)
    echo "usage: $0 {deploy|destroy|collect [<dir>]|exec <node> <command>...}" >&2
    echo "  DOT2NET_LAB_NAME    deploy under another lab name" >&2
    echo "  DOT2NET_COLLECT_DIR where collected files go" >&2
    exit 2
    ;;
esac

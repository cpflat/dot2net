#!/bin/sh
# Generated by dot2net. The entry point for this lab on containerlab: run it
# from anywhere, it works out where its files are.
set -e
cd "$(dirname "$0")"
TOPO="%%TOPO%%"

case "${1:-deploy}" in
  deploy)
    exec containerlab deploy -t "$TOPO"
    ;;
  destroy)
    exec containerlab destroy -t "$TOPO" --cleanup
    ;;
  exec)
    shift
    [ $# -ge 2 ] || { echo "usage: $0 exec <node> <command>..." >&2; exit 2; }
    node="$1"; shift
    exec containerlab exec -t "$TOPO" --label clab-node-name="$node" --cmd "$*"
    ;;
  *)
    echo "usage: $0 {deploy|destroy|exec <node> <command>...}" >&2
    exit 2
    ;;
esac

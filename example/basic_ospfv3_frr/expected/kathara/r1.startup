sysctl -w net.ipv6.conf.all.forwarding=1
sysctl -w net.ipv6.conf.all.disable_ipv6=0
sysctl -w net.ipv6.conf.all.seg6_enabled=1
sysctl -w net.ipv4.conf.all.rp_filter=0
sysctl -w net.ipv6.conf.default.forwarding=1
sysctl -w net.ipv6.conf.default.disable_ipv6=0
sysctl -w net.ipv6.conf.default.seg6_enabled=1
sysctl -w net.ipv4.conf.default.rp_filter=0
sysctl -w net.ipv6.conf.eth0.disable_ipv6=0
sysctl -w net.ipv6.conf.eth0.seg6_enabled=1
sysctl -w net.ipv4.conf.eth0.rp_filter=0
sysctl -w net.ipv6.conf.eth1.disable_ipv6=0
sysctl -w net.ipv6.conf.eth1.seg6_enabled=1
sysctl -w net.ipv4.conf.eth1.rp_filter=0
sysctl -w net.ipv6.conf.eth2.disable_ipv6=0
sysctl -w net.ipv6.conf.eth2.seg6_enabled=1
sysctl -w net.ipv4.conf.eth2.rp_filter=0
ip -6 addr add fd00:1234::1/64 dev eth0
ip -6 addr add fd00:1234:0:1::1/64 dev eth1
ip -6 addr add fd00:1234:0:2::2/64 dev eth2
vtysh -c "conf t" -c "router ospf6" -c "ospf6 router-id 10.255.0.1"
vtysh -c "conf t" -c "interface eth0" -c "ipv6 ospf6 area 0.0.0.0"
vtysh -c "conf t" -c "interface eth1" -c "ipv6 ospf6 area 0.0.0.0"
vtysh -c "conf t" -c "interface eth2" -c "ipv6 ospf6 area 0.0.0.0"
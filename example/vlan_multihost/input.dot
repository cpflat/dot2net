digraph {
	// Each host is a group. The class sits in xlabel so that label stays
	// available as a display title; a subgraph's label doubles as a class.
	subgraph host1 {
		xlabel="worker";
		r1[xlabel="router"];
		r2[xlabel="router"];
	}
	subgraph host2 {
		xlabel="worker";
		r3[xlabel="router"];
		r4[xlabel="router"];
	}

	// Links that stay inside one host.
	r1->r2[dir="none", xlabel="segment#intra"];
	r3->r4[dir="none", xlabel="segment#intra"];

	// The hosts meet on a shared L2 domain that the platform provides: a bridge
	// for containerlab, a switches: entry for TiNET. sw_inter belongs to no
	// host, so neither host file carries these links.
	sw_inter[xlabel="platform_sw"];
	r2->sw_inter[dir="none", xlabel="segment#inter"];
	r3->sw_inter[dir="none", xlabel="segment#inter"];
}

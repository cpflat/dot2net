digraph {
	// Each host is a group. The class sits in xlabel so that label stays
	// available as a display title; a subgraph's label doubles as a class.
	subgraph host1 {
		xlabel="worker";
		r1[xlabel="router"];
		r2[xlabel="router"];
	}
	subgraph host2 {
		xlabel="worker";
		r3[xlabel="router"];
		r4[xlabel="router"];
	}

	// Links that stay inside one host.
	r1->r2[dir="none", xlabel="segment#intra"];
	r3->r4[dir="none", xlabel="segment#intra"];

	// A link across the host boundary. It belongs to no single host, so it
	// must not appear in either host file.
	r2->r3[dir="none", xlabel="segment#inter"];
}

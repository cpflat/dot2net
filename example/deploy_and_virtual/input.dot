digraph {
	// A small site, drawn as it actually is: not everything in the picture is a
	// container of ours, and not everything of ours is ours to configure.
	//
	//   edge1, edge2 - our routers
	//   lan          - the segment they share. Every platform has one of these
	//                  already, so we take the platform's rather than run our own
	//   isp          - the upstream router, on the same segment. Someone else
	//                  runs it. We draw it so that the address it holds is one
	//                  nobody else is given: edge1 gets .1, isp .2, edge2 .3
	//   probe        - an appliance that arrives configured. We start it and
	//                  leave it alone
	//   the overlay  - edge1 and edge2 also reach each other over a tunnel they
	//                  build themselves. Nothing lays a wire for it

	edge1[xlabel="router"];
	edge2[xlabel="router"];
	lan[xlabel="shared_lan"];
	isp[xlabel="upstream"];
	probe[xlabel="router,preconfigured"];

	edge1->lan[dir="none"];
	edge2->lan[dir="none"];
	isp->lan[dir="none"];

	edge1->edge2[dir="none", class="overlay", headlabel="vxlan", taillabel="vxlan"];

	// The appliance addresses this link itself, so our end says nothing.
	edge1->probe[dir="none", taillabel="unmanaged"];
}

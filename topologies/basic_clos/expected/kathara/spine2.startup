/usr/lib/frr/frr start
vtysh -c "conf t" -c "ip forwarding" -c "int lo" -c "ip addr 10.255.0.6/32" -c "router bgp 65005" -c "bgp router-id 10.255.0.6" -c "bgp bestpath as-path multipath-relax" -c "bgp bestpath compare-routerid"
vtysh -c "conf t" -c "int eth0" -c "ip addr 10.0.0.5/30" -c "router bgp 65005" -c "neighbor 10.0.0.6 remote-as 65000"
vtysh -c "conf t" -c "int eth1" -c "ip addr 10.0.0.21/30" -c "router bgp 65005" -c "neighbor 10.0.0.22 remote-as 65001"
vtysh -c "conf t" -c "int eth2" -c "ip addr 10.0.0.37/30" -c "router bgp 65005" -c "neighbor 10.0.0.38 remote-as 65002"
vtysh -c "conf t" -c "int eth3" -c "ip addr 10.0.0.53/30" -c "router bgp 65005" -c "neighbor 10.0.0.54 remote-as 65003"
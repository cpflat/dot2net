touch /var/log/frr.log
chown frr:frr /var/log/frr.log
vtysh -c "conf t" -c "log file /var/log/frr.log informational"
/usr/lib/frr/frr start
ip addr add 10.0.0.6/30 dev eth0
ip addr add 10.0.0.17/30 dev eth1
ip addr add 10.0.0.22/30 dev eth2
vtysh -c "conf t" -c "router ospf" -c "network 10.0.0.4/30 area 0"
vtysh -c "conf t" -c "router ospf" -c "network 10.0.0.16/30 area 0"
vtysh -c "conf t" -c "router ospf" -c "network 10.0.0.20/30 area 0"
touch /var/log/frr.log
chown frr:frr /var/log/frr.log
vtysh -c "conf t" -c "log file /var/log/frr.log informational"
sysctl -w net.ipv4.ip_forward=1
ip link add name br101 type bridge stp_state 0
ip addr add 10.10.0.2/24 dev br101
ip link set dev br101 up
ip link add vxlan101 type vxlan id 101 dstport 4789 local 10.255.0.2 nolearning
ip link set dev vxlan101 master br101
ip link set up dev vxlan101
ip link set dev eth0 master br101
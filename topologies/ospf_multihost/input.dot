digraph {
	// A single OSPF area spread over two machines. Compare example/ospf_simple,
	// which is the same protocol on one machine: the routing configuration below
	// is unchanged, and only the placement is new.
	//
	// Each machine is a group of class "worker" - dot2net's word for a placement
	// unit. containerlab writes one topology file per worker, holding that
	// machine's nodes and the links it can wire itself.
	subgraph host1 {
		xlabel="worker";
		r1[xlabel="router"];
		r2[xlabel="router"];
		// The bridge the machine provides. It carries no address, so a search
		// for an IP segment passes straight through it.
		br1[xlabel="platform_sw"];
	}
	subgraph host2 {
		xlabel="worker";
		r3[xlabel="router"];
		r4[xlabel="router"];
		br2[xlabel="platform_sw"];
	}

	// Links inside one machine. containerlab wires these with veth.
	r1->r2[dir="none"];
	r3->r4[dir="none"];

	// Each machine's border router meets its own bridge.
	r2->br1[dir="none"];
	r3->br2[dir="none"];

	// The one link that leaves a machine. Nothing inside containerlab can make
	// it - the two bridges are joined outside the lab - so it appears in no
	// topology file and is listed in inter-host-links.txt instead. r2 and r3
	// still share one IP segment across the two machines, which is what lets
	// their OSPF adjacency come up.
	br1->br2[dir="none"];
}
